{
  "name": "@radio/db",
  "version": "0.0.0",
  "private": true,
  "description": "Postgres access: the declarative schema (schema/*.sql, applied with pg-delta) and the typed queries the app needs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "schema:plan": "tsx scripts/schema.ts plan",
    "schema:apply": "tsx scripts/schema.ts apply",
    "schema:lint": "pgdelta schema lint --dir schema",
    "sql": "tsx scripts/sql.ts",
    "clear": "tsx scripts/clear.ts"
  },
  "dependencies": {
    "pg": "^8.23.0"
  },
  "devDependencies": {
    "@supabase/pg-delta": "1.0.0-alpha.42",
    "@supabase/pg-topo": "1.0.0-alpha.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3"
  }
}

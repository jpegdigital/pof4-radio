{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "description": "Next.js app: the player (Spotify Web Playback SDK in the browser), the Spotify sign-in, and the pages that read from Postgres.",
  "scripts": {
    "dev": "next dev --experimental-https -H dev.radio.pof4.com",
    "build": "next build",
    "start": "next start",
    "typecheck": "next typegen && tsc --noEmit",
    "typegen": "next typegen"
  },
  "dependencies": {
    "@radio/db": "workspace:*",
    "@radio/spotify": "workspace:*",
    "jose": "6.2.10",
    "next": "16.3.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "^5.9.3"
  }
}

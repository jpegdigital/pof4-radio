# Local dev environment — 1Password secret references, safe to commit.
# Run anything with:   op run --env-file=.env.op -- <command>
#
# Postgres — the shared Railway server over its public proxy, database `radio` (dev and prod share it).
# Vault item "railway-radio-postgres" (Database): same host/user/pass as dreamweaver's, database = radio.
DATABASE_URL=op://Developer/railway-radio-postgres/database_url

# Spotify app (developer.spotify.com → Dashboard). The browser runs the user (PKCE) flow with the id alone.
# Vault item "railway-radio-spotify" (Developer vault, API Credential): username = client id, credential = secret.
SPOTIFY_CLIENT_ID=op://Developer/railway-radio-spotify/username
SPOTIFY_CLIENT_SECRET=op://Developer/railway-radio-spotify/credential

# Claude and ElevenLabs (web). Vault items "pof4-radio-claude-pof4" and "pof4-radio-elevenlabs-proart" (Developer).
CLAUDE_KEY=op://Developer/pof4-radio-claude-pof4/credential
CLAUDE_MODEL=claude-opus-5
ELEVENLABS_KEY=op://Developer/pof4-radio-elevenlabs-proart/credential

# The clips bucket — Railway's S3-compatible bucket `radio-clips` in the radio group (declared in
# ../pof4-infra). Voice mp3s go here, keyed per segment, immutable. Vault item
# "pof4-radio-clips-bucket" (Developer, API Credential): the five values as `railway variables
# -s radio-web` shows them; username = access key id, credential = secret access key.
BUCKET_ENDPOINT=op://Developer/pof4-radio-clips-bucket/endpoint
BUCKET_NAME=op://Developer/pof4-radio-clips-bucket/bucket
BUCKET_REGION=op://Developer/pof4-radio-clips-bucket/region
BUCKET_ACCESS_KEY_ID=op://Developer/pof4-radio-clips-bucket/username
BUCKET_SECRET_ACCESS_KEY=op://Developer/pof4-radio-clips-bucket/credential

# Guard — the pof4 passkey sign-in. Dev is served at https://dev.radio.pof4.com:3000 so the
# .pof4.com cookie reaches it (README "Run locally"). Plain values, not secrets.
GUARD_URL=https://guard.pof4.com
GUARD_JWKS_URL=https://guard.pof4.com/api/auth/jwks

# Local dev environment — 1Password secret references, safe to commit.
# Run anything with:   op run --env-file=.env.op -- <command>
#
# Postgres — the shared Railway server over its public proxy, database `radio` (dev and prod share it).
# Vault item "railway-radio-postgres" (Database): same host/user/pass as dreamweaver's, database = radio.
DATABASE_URL=op://Developer/railway-radio-postgres/database_url

# Spotify app (developer.spotify.com → Dashboard). Redirect URI must be registered there exactly.
# Vault item "railway-radio-spotify" (Developer vault, API Credential): username = client id, credential = secret.
SPOTIFY_CLIENT_ID=op://Developer/railway-radio-spotify/username
SPOTIFY_CLIENT_SECRET=op://Developer/railway-radio-spotify/credential
SPOTIFY_REDIRECT_URI=https://dev.radio.pof4.com:3000/api/spotify/callback

# Claude (worker). Vault item "pof4-radio-claude-pof4" (Developer). ElevenLabs lands with the DJ loop.
CLAUDE_KEY=op://Developer/pof4-radio-claude-pof4/credential
CLAUDE_MODEL=claude-sonnet-5
# ELEVENLABS_KEY=op://Developer/elevenlabs-radio/credential

# Guard — the pof4 passkey sign-in. Dev is served at https://dev.radio.pof4.com:3000 so the
# .pof4.com cookie reaches it (README "Run locally"). Plain values, not secrets.
GUARD_URL=https://guard.pof4.com
GUARD_JWKS_URL=https://guard.pof4.com/api/auth/jwks

{
  "name": "radio",
  "private": true,
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "op run --env-file=.env.op -- pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "typecheck": "pnpm --filter web typecheck && tsc -p tsconfig.json",
    "lint": "pnpm --filter web typegen && eslint . && pgdelta schema lint --dir db/schema",
    "lint:fix": "pnpm --filter web typegen && eslint . --fix",
    "db:plan": "op run --env-file=.env.op -- node db/schema.mts plan",
    "db:apply": "op run --env-file=.env.op -- node db/schema.mts apply",
    "db:sql": "op run --env-file=.env.op -- node db/sql.mts",
    "db:clear": "op run --env-file=.env.op -- node db/clear.mts",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@supabase/pg-delta": "1.0.0-alpha.42",
    "@supabase/pg-topo": "1.0.0-alpha.5",
    "@types/node": "^24",
    "@types/pg": "^8.23.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.1",
    "pg": "^8.23.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "unrs-resolver"
    ]
  }
}
